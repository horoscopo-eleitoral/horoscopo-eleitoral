---
import Base from '../layouts/Base.astro';
import CeuDoDia from '../components/CeuDoDia.astro';
import Ilustracao from '../components/Ilustracao.astro';
import { todosSignos, diaAtual, dataPorExtenso, diasAteSegundoTurno } from '../lib/conteudo.js';

const dia = diaAtual();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const faltam = diasAteSegundoTurno();
---
<Base
  titulo="Horóscopo do dia para todos os signos"
  descricao={`Horóscopo de ${dataPorExtenso(dia.data)}: amor, trabalho, dinheiro e saúde para os 12 signos. E o que os astros dizem sobre o 2º turno.`}
>
  <div class="mt-6 text-center">
    <p class="m-0 text-sm text-on-surface-variant first-letter:uppercase">{dataPorExtenso(dia.data)}</p>
    <h1 class="my-2 text-[clamp(1.8rem,6vw,2.4rem)]">Horóscopo de hoje</h1>
    <p class="mx-auto my-4 max-w-sm font-headline text-lg text-on-surface italic">“{dia.frase_do_dia}”</p>
    <CeuDoDia ceu={dia.ceu} />
  </div>

  <ul class="mt-8 mb-6 grid list-none grid-cols-3 gap-x-3 gap-y-7 p-0">
    {todosSignos().map((s, i) => (
      <li>
        <a href={`${base}/${s.slug}/`} class="group flex flex-col items-center text-center text-on-surface no-underline">
          <Ilustracao
            slug={s.slug} nome={s.nome} carregar={i < 6 ? 'eager' : 'lazy'}
            class="h-28 w-full opacity-85 transition group-hover:opacity-100 group-hover:drop-shadow-[0_0_8px_rgb(242_202_80/0.35)]"
          />
          <span class="mt-2 font-headline font-semibold">{s.nome}</span>
          <span class="text-xs text-outline">{s.periodo}</span>
        </a>
      </li>
    ))}
  </ul>

  <p class="text-center text-sm text-outline">Faltam <b class="text-on-surface-variant">{faltam} dias</b> para o 2º turno, em 25 de outubro.</p>
  <p class="text-center"><a href={`${base}/faq/`} class="font-semibold">Onde voto, documento, horário, ônibus de graça →</a></p>
</Base>
