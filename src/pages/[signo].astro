---
import Base from '../layouts/Base.astro';
import MandarParaAlguem from '../components/MandarParaAlguem.astro';
import PlanoDeVoto from '../components/PlanoDeVoto.astro';
import CeuDoDia from '../components/CeuDoDia.astro';
import Ilustracao from '../components/Ilustracao.astro';
import Cartao from '../components/Cartao.astro';
import Rotulo from '../components/Rotulo.astro';
import { todosSignos, leituraDoSigno, dataPorExtenso, fase } from '../lib/conteudo.js';

export function getStaticPaths() {
  return todosSignos().map((s) => ({ params: { signo: s.slug } }));
}

const { signo: slug } = Astro.params;
const { dia, signo, texto, proposta, contraste, retrogrado, combina } = leituraDoSigno(slug);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const dataExtenso = dataPorExtenso(dia.data);
const urlPagina = new URL(`${base}/${slug}/`, Astro.site).href;
const textoZap = `Horóscopo de ${signo.nome} hoje (${dataExtenso}): ${texto.trabalho} Veja o resto em ${urlPagina}`;
const urlZap = `https://wa.me/?text=${encodeURIComponent(textoZap)}`;
const faseAtual = fase(dia);
const ultimoDia = faseAtual === 'eleicao';
const imagemOg = new URL(`${base}/og/${slug}.png`, Astro.site).href;
---
<Base
  titulo={`Horóscopo de ${signo.nome} hoje, ${dataExtenso}`}
  descricao={`Veja como ${signo.nome} será influenciado hoje no amor, trabalho, dinheiro e saúde. E o número da sorte do 2º turno.`}
  signoAtual={slug}
  imagem={imagemOg}
>
  <header class="mt-4 text-center">
    <Ilustracao slug={slug} nome={signo.nome} carregar="eager" class="mx-auto h-56 w-full" />
    <h1 class="mt-4 mb-1 text-[clamp(1.8rem,6vw,2.4rem)]">{signo.nome}</h1>
    <p class="m-0 text-sm text-on-surface-variant first-letter:uppercase">
      {dataExtenso} · {signo.periodo}
      {!ultimoDia && <span class="ml-1 text-outline" title="Os astros só revelam amanhã">· 🔒 amanhã</span>}
    </p>
    <CeuDoDia ceu={dia.ceu} class="mt-3" />
  </header>

  {ultimoDia && <Cartao destaque class="mt-6 p-4! text-center text-base">🗳️ <b>Hoje é dia.</b> Os astros só pedem uma coisa: vá votar. Urnas das 8h às 17h.</Cartao>}

  <dl class="mt-8 mb-0 space-y-5">
    {[['Amor', texto.amor], ['Trabalho', texto.trabalho], ['Dinheiro', texto.dinheiro], ['Saúde', texto.saude]].map(([area, frase]) => (
      <div>
        <dt><Rotulo>{area}</Rotulo></dt>
        <dd class="m-0 mt-1">{frase}</dd>
      </div>
    ))}
  </dl>

  {faseAtual !== 'convencer' && <PlanoDeVoto diaDaEleicao={ultimoDia} />}

  <Cartao destaque class="mt-8">
    <div class="flex items-baseline justify-between">
      <Rotulo>✦ Sorte do dia</Rotulo>
      <span class="text-sm text-on-surface-variant">cor: {dia.cor_do_dia}</span>
    </div>
    <details class="group">
      <summary class="mt-1 flex cursor-pointer items-center justify-between">
        <span class="font-headline text-5xl leading-none text-primary">13</span>
        <span class="font-semibold text-primary underline decoration-gold-line-strong underline-offset-4">
          Por que 13? <span class="group-open:hidden">▾</span><span class="hidden group-open:inline">▴</span>
        </span>
      </summary>
      <div class="mt-5">
        <Rotulo>{signo.nome} e o 2º turno</Rotulo>
        <p class="mt-1 mb-0 text-sm text-on-surface-variant">Do lado de <b class="text-on-surface">Lula (PT)</b>:</p>
        <p class="mt-2 mb-1 font-headline text-xl text-on-surface">{proposta.fato}</p>
        <p class="text-[0.8rem] text-outline">Fonte: <a href={proposta.fonte.url} rel="noopener" target="_blank">{proposta.fonte.nome}</a></p>
        <p class="my-4 font-headline text-lg text-on-surface italic">“{proposta.pergunta}”</p>
        {contraste && (
          <div class="mt-5 border-t border-dashed border-gold-line-strong pt-4">
            <Rotulo>{retrogrado ? `${retrogrado.simbolo} ${retrogrado.titulo}` : 'Os astros avisam'}</Rotulo>
            <p class="mt-1 mb-2 text-sm text-on-surface-variant">Do outro lado, o adversário, <b class="text-on-surface">Flávio Bolsonaro (PL)</b>:</p>
            <p class="mt-2 mb-1 text-[1.05rem] text-on-surface">{contraste.fato}</p>
            <p class="text-[0.8rem] text-outline">Fonte: <a href={contraste.fonte.url} rel="noopener" target="_blank">{contraste.fonte.nome}</a></p>
            <p class="my-4 font-headline text-lg text-on-surface italic">“{contraste.pergunta}”</p>
          </div>
        )}
        <p class="font-semibold text-primary">No dia 25, os astros recomendam: Lula <span class="font-headline text-2xl">13</span></p>
        <p class="mb-0 text-sm text-on-surface-variant"><b class="text-on-surface">Os astros recomendam hoje:</b> {texto.recomendacao}</p>
      </div>
    </details>
  </Cartao>

  <section class="mt-10 text-center">
    <p class="mb-3 text-on-surface-variant">
      Hoje {signo.nome} combina com <b class="text-on-surface"><span class="glifo">{combina.simbolo}</span> {combina.nome}</b>.
    </p>
    <details class="group text-left">
      <summary class="cursor-pointer">
        <span class="inline-flex min-h-14 w-full items-center justify-center rounded-2xl bg-whatsapp px-6 font-bold text-white group-open:hidden">
          Mandar pra alguém de {combina.nome}
        </span>
      </summary>
      <MandarParaAlguem signoSugerido={combina.slug} />
    </details>
    <p class="mt-4 text-sm">
      <a href={urlZap} target="_blank" rel="noopener">Compartilhar meu horóscopo</a>
      <span class="mx-2 text-outline">·</span>
      <button type="button" class="cursor-pointer text-secondary underline" data-copiar={urlPagina}>copiar link</button>
    </p>
  </section>

  <script>
    document.querySelectorAll<HTMLElement>('[data-copiar]').forEach((b) => {
      b.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(b.dataset.copiar!);
          b.textContent = 'Link copiado ✓';
        } catch {
          prompt('Copie o link:', b.dataset.copiar);
        }
      });
    });
  </script>
</Base>
