---
import Base from '../layouts/Base.astro';
import MandarParaAlguem from '../components/MandarParaAlguem.astro';
import PlanoDeVoto from '../components/PlanoDeVoto.astro';
import CeuDoDia from '../components/CeuDoDia.astro';
import Constelacao from '../components/Constelacao.astro';
import Cartao from '../components/Cartao.astro';
import Rotulo from '../components/Rotulo.astro';
import Botao from '../components/Botao.astro';
import { todosSignos, leituraDoSigno, dataPorExtenso, fase } from '../lib/conteudo.js';

export function getStaticPaths() {
  return todosSignos().map((s) => ({ params: { signo: s.slug } }));
}

const { signo: slug } = Astro.params;
const { dia, signo, texto, proposta, contraste, retrogrado, combina } = leituraDoSigno(slug);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const dataExtenso = dataPorExtenso(dia.data);
const urlPagina = new URL(`${base}/${slug}/`, Astro.site).href;
const textoZap = `Horóscopo de ${signo.nome} hoje (${dataExtenso}): ${texto.trabalho} Veja o resto em ${urlPagina}`;
const urlZap = `https://wa.me/?text=${encodeURIComponent(textoZap)}`;
const faseAtual = fase(dia);
const ultimoDia = faseAtual === 'eleicao';
const imagemOg = new URL(`${base}/og/${slug}.png`, Astro.site).href;
---
<Base
  titulo={`Horóscopo de ${signo.nome} hoje, ${dataExtenso}`}
  descricao={`Veja como ${signo.nome} será influenciado hoje no amor, trabalho, dinheiro e saúde. E o número da sorte do 2º turno.`}
  signoAtual={slug}
  imagem={imagemOg}
>
  <div class="mt-4.5 mb-1.5 flex items-center gap-4">
    <Constelacao
      slug={slug} nome={signo.nome}
      class="size-26 flex-none rounded-full border border-gold-line-strong bg-surface-container-low p-3 shadow-glow"
    />
    <div>
      <Rotulo><span aria-hidden="true">{signo.simbolo}</span> {signo.periodo}</Rotulo>
      <h1 class="my-1 text-[clamp(1.6rem,5vw,2.3rem)]">Horóscopo de {signo.nome}</h1>
      <p class="m-0 text-on-surface-variant">{dataExtenso}</p>
    </div>
  </div>

  <div class="my-2.5 flex gap-2 text-sm">
    <span class="rounded-full bg-primary-container px-4 py-1.5 font-bold text-on-primary">Hoje</span>
    {!ultimoDia && <span class="rounded-full border border-gold-line px-4 py-1.5 text-outline" title="Os astros só revelam amanhã">🔒 Amanhã</span>}
  </div>

  <CeuDoDia ceu={dia.ceu} />

  {ultimoDia && <Cartao destaque class="p-4! text-base">🗳️ <b>Hoje é dia.</b> Os astros só pedem uma coisa: vá votar. Urnas das 8h às 17h.</Cartao>}

  <Cartao>
    <ul class="m-0 list-none divide-y divide-gold-line p-0">
      {[['Amor', texto.amor], ['Trabalho', texto.trabalho], ['Dinheiro', texto.dinheiro], ['Saúde', texto.saude]].map(([area, frase]) => (
        <li class="py-3 first:pt-0 last:pb-0"><b class="font-semibold text-secondary">{area}:</b> {frase}</li>
      ))}
    </ul>
  </Cartao>

  {faseAtual !== 'convencer' && <PlanoDeVoto diaDaEleicao={ultimoDia} />}

  <Cartao destaque>
    <Rotulo>✦ Sorte do dia</Rotulo>
    <p class="mt-1.5 mb-0">Número: <span class="font-headline text-[2.6rem] leading-none text-primary">13</span> &nbsp;·&nbsp; Cor: <b>{dia.cor_do_dia}</b></p>

    <details class="group">
      <summary class="mt-2.5 cursor-pointer font-semibold text-primary underline decoration-gold-line-strong underline-offset-4 group-open:mb-3.5">
        Por que 13? <span class="group-open:hidden">▾</span><span class="hidden group-open:inline">▴</span>
      </summary>
      <Rotulo>{signo.nome} e o 2º turno</Rotulo>
      <p class="mt-2.5 mb-1 font-headline text-xl text-on-surface">{proposta.fato}</p>
      <p class="text-[0.8rem] text-outline">Fonte: <a href={proposta.fonte.url} rel="noopener" target="_blank">{proposta.fonte.nome}</a></p>
      <p class="my-4 font-headline text-lg text-on-surface italic">“{proposta.pergunta}”</p>
      {contraste && (
        <div class="mt-4 border-t border-dashed border-gold-line-strong pt-3.5">
          <Rotulo>{retrogrado ? `${retrogrado.simbolo} ${retrogrado.titulo}` : 'Os astros avisam'}</Rotulo>
          <p class="mt-0.5 mb-1.5 text-sm text-on-surface-variant">Retrógrado é quando o planeta parece andar pra trás.</p>
          <p class="mt-2 mb-1 text-[1.05rem] text-on-surface">{contraste.fato}</p>
          <p class="text-[0.8rem] text-outline">Fonte: <a href={contraste.fonte.url} rel="noopener" target="_blank">{contraste.fonte.nome}</a></p>
          <p class="my-4 font-headline text-lg text-on-surface italic">“{contraste.pergunta}”</p>
        </div>
      )}
      <p class="font-semibold text-primary">No dia 25, os astros recomendam: Lula <span class="font-headline text-2xl">13</span></p>
      <p class="mb-0 text-sm"><b>Os astros recomendam hoje:</b> {texto.recomendacao}</p>
    </details>
  </Cartao>

  <Cartao>
    <Rotulo>✧ Combina hoje com</Rotulo>
    <p class="mt-1.5 mb-2.5"><b><span class="glifo">{combina.simbolo}</span> {combina.nome}</b>. Conhece alguém de {combina.nome}? Manda o horóscopo pra essa pessoa.</p>
    <MandarParaAlguem signoSugerido={combina.slug} />
  </Cartao>

  <section class="mt-3 grid gap-2.5 min-[480px]:grid-cols-2">
    <Botao variante="whatsapp" href={urlZap} target="_blank" rel="noopener">Compartilhar</Botao>
    <Botao variante="contorno" data-copiar={urlPagina}>Copiar link</Botao>
  </section>

  <script>
    document.querySelectorAll<HTMLElement>('[data-copiar]').forEach((b) => {
      b.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(b.dataset.copiar!);
          b.textContent = 'Link copiado ✓';
        } catch {
          prompt('Copie o link:', b.dataset.copiar);
        }
      });
    });
  </script>
</Base>
