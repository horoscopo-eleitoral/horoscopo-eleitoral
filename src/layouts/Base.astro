---
import '../styles/global.css';
import { todosSignos } from '../lib/conteudo.js';

const { titulo, descricao, signoAtual, imagem } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = new URL(Astro.url.pathname, Astro.site).href;
const og = imagem ?? new URL(`${base}/og.png`, Astro.site).href;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo} · Horóscopo Eleitoral</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={url} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={og} />
    <meta property="og:locale" content="pt_BR" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,400&display=swap" rel="stylesheet" />
    <meta name="theme-color" content="#080d1e" />
  </head>
  <body>
    <header class="pt-6 pb-1.5 text-center">
      <a class="text-xs font-semibold uppercase tracking-[0.22em] text-secondary no-underline" href={`${base}/`}>
        ✦ Horóscopo Eleitoral
        <small class="mt-0.5 block text-[0.7rem] font-normal normal-case tracking-wide text-outline">o 2º turno escrito nas estrelas</small>
      </a>
    </header>

    <nav class="mx-auto max-w-[540px] px-5" aria-label="Signos">
      <ul class="m-0 grid list-none grid-cols-6 gap-1 p-0 pt-3 pb-1.5">
        {todosSignos().map((s) => {
          const atual = s.slug === signoAtual;
          return (
            <li>
              <a
                href={`${base}/${s.slug}/`}
                aria-current={atual ? 'page' : undefined}
                class:list={['flex flex-col items-center gap-[3px] py-1 text-[0.62rem] no-underline', atual ? 'font-semibold text-primary' : 'text-outline']}
              >
                <span
                  aria-hidden="true"
                  class:list={[
                    'glifo grid size-10 place-items-center rounded-full border text-xl',
                    atual ? 'border-primary bg-primary-container text-on-primary shadow-glow' : 'border-gold-line bg-surface-container-low text-secondary',
                  ]}
                >{s.simbolo}</span>
                {s.nome}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <main class="mx-auto max-w-[540px] px-5">
      <slot />
    </main>

    <footer class="mx-auto mt-10 mb-7 max-w-[540px] px-5 text-center text-xs tracking-wide text-outline">
      <p>
        Horóscopo Eleitoral é um projeto voluntário e independente, com intenção eleitoral declarada:
        convencer quem ainda não decidiu a votar no Lula no 2º turno, dia 25 de outubro.
        Sem vínculo com partido ou campanha. Sem impulsionamento pago.
      </p>
      <p><a class="text-inherit" href={`${base}/sobre/`}>Sobre o projeto e fontes</a></p>
    </footer>
  </body>
</html>
