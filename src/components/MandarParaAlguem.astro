---
import { todosSignos } from '../lib/conteudo.js';
const { signoSugerido } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const signos = todosSignos().map((s) => ({ slug: s.slug, nome: s.nome, simbolo: s.simbolo, url: new URL(`${base}/${s.slug}/`, Astro.site).href }));
---
<div class="mandar" data-signo={signoSugerido}>
  <label class="pequeno" for="nome-amigo">Nome da pessoa (opcional)</label>
  <input class="campo" id="nome-amigo" type="text" placeholder="Ex.: Ana" autocomplete="off" />

  <div class="chips" role="group" aria-label="Signo da pessoa">
    {signos.map((s) => (
      <button type="button" data-slug={s.slug} data-nome={s.nome} data-url={s.url} aria-pressed={s.slug === signoSugerido ? 'true' : 'false'}>
        {s.simbolo} {s.nome}
      </button>
    ))}
  </div>

  <div class="balao" data-previa></div>
  <a class="botao zap" data-enviar href="#" target="_blank" rel="noopener">Mandar no WhatsApp</a>
</div>

<script>
  document.querySelectorAll('.mandar').forEach((raiz) => {
    const nome = raiz.querySelector('#nome-amigo');
    const chips = [...raiz.querySelectorAll('.chips button')];
    const previa = raiz.querySelector('[data-previa]');
    const enviar = raiz.querySelector('[data-enviar]');

    function montar() {
      const ativo = chips.find((c) => c.getAttribute('aria-pressed') === 'true');
      const quem = nome.value.trim();
      const msg = `${quem ? quem + ', ' : ''}vi o horóscopo de ${ativo.dataset.nome} de hoje e lembrei de você 👀\n${ativo.dataset.url}`;
      previa.textContent = msg;
      enviar.href = `https://wa.me/?text=${encodeURIComponent(msg)}`;
    }

    chips.forEach((c) => c.addEventListener('click', () => {
      chips.forEach((o) => o.setAttribute('aria-pressed', 'false'));
      c.setAttribute('aria-pressed', 'true');
      montar();
    }));
    nome.addEventListener('input', montar);
    montar();
  });
</script>
