---
// Aparece nos últimos dias (fase "levar"): o que importa é ir votar.
import Cartao from './Cartao.astro';
import Rotulo from './Rotulo.astro';
const { diaDaEleicao = false } = Astro.props;
---
<Cartao destaque>
  <Rotulo>🗳️ {diaDaEleicao ? 'Hoje é dia de votar' : 'Seu plano de voto'}</Rotulo>
  {diaDaEleicao
    ? <p class="mt-1.5 mb-2.5">Urnas abertas das <b>8h às 17h</b>. Leve um documento oficial com foto. Faltou no 1º turno? Pode votar normalmente hoje.</p>
    : <p class="mt-1.5 mb-2.5">Quem planeja, vota. Responda as 5 perguntas e mande pra alguém que ainda não respondeu.</p>}
  <ol class="m-0 list-decimal space-y-2.5 pl-6">
    <li><b>Onde?</b> Confira no app <a href="https://www.tse.jus.br/eleitor/titulo-e-local-de-votacao/consulta-por-nome" rel="noopener" target="_blank">e-Título ou no site do TSE</a>.</li>
    <li><b>Que horas?</b> Um horário de verdade, não "mais tarde".</li>
    <li><b>Como vai?</b> A pé, de ônibus ou com a família. Veja se a sua cidade terá tarifa zero.</li>
    <li><b>Com quem?</b> Ir acompanhado faz diferença, ainda mais pra quem mora só.</li>
    <li><b>Documento?</b> Qualquer um oficial com foto. O título não é obrigatório.</li>
  </ol>
  <p class="mt-3 mb-0 text-sm text-on-surface-variant">Faltou no 1º turno? Pode votar normalmente no 2º.</p>
</Cartao>
